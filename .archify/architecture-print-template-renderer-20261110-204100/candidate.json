    {
      "dot": "cyan",
      "title": "URL-Driven Ingestion",
      "items": [
        "URL parameters parsed for format type, source URL, data JSON, and config JSON",
        "Automatic URL normalization for Google Drive and GitHub raw repository links",
        "Interactive drawer allows live JSON tuning and 1-click preset switching"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three Rendering Pipelines",
      "items": [
        "Typst: Compiles native markup to PDF via WebAssembly with #auto_table() injection",
        "DOCX: Binds data tables with docxtemplater and captures pages via html2canvas + jsPDF",
        "SVG: Vector element replacement and dynamic SVG table generator with svg2pdf.js"
      ]
    },
    {
      "dot": "violet",
      "title": "Preview & Delivery",
      "items": [
        "PDF.js multi-page rasterizer with continuous vertical scroll and grid overview",
        "Thumbnail navigation strip, 50%-300% zoom, rotation, and fullscreen mode",
        "Native browser print dialog and high-res vector PDF export"
      ]
